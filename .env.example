POSTGRES_PASSWORD=change-me
SHERPA_DB_HOST=127.0.0.1
SHERPA_DB_PORT=5432
SHERPA_DB_NAME=sherpa
# Read by dbt and the tests via .env; make takes it from the environment or CLI (default sherpa_eval). It must start
# with sherpa_eval and contain only [a-z0-9_].
SHERPA_EVAL_DB_NAME=sherpa_eval
SHERPA_ADMIN_USER=sherpa_admin
SHERPA_ADMIN_PASSWORD=change-me
SHERPA_AGENT_USER=sherpa_agent
SHERPA_AGENT_PASSWORD=change-me
SHERPA_DBT_TARGET_PATH=data-platform/dbt/target-prod
# The MCP server's transport (stdio or http) and its HTTP port (bound to 127.0.0.1).
MCP_TRANSPORT=stdio
SHERPA_MCP_PORT=8765
# Optional: with a token, the MCP server sends its traces to Logfire; without one it sends nothing.
# LOGFIRE_TOKEN=
# Behind a TLS-intercepting proxy, point uv and dbt at a CA bundle that includes the proxy's root certificate:
# SSL_CERT_FILE=/path/to/ca-bundle.pem
# REQUESTS_CA_BUNDLE=/path/to/ca-bundle.pem
