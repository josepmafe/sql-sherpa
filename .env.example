POSTGRES_PASSWORD=change-me
SHERPA_DB_HOST=127.0.0.1
SHERPA_DB_PORT=5432
SHERPA_DB_NAME=sherpa
# Read by dbt and the tests via .env; make takes it from the environment or CLI (default sherpa_eval). It must start
# with sherpa_eval and contain only [a-z0-9_].
SHERPA_EVAL_DB_NAME=sherpa_eval
SHERPA_ADMIN_USER=sherpa_admin
SHERPA_ADMIN_PASSWORD=change-me
SHERPA_AGENT_USER=sherpa_agent
SHERPA_AGENT_PASSWORD=change-me
SHERPA_UI_USER=sherpa_ui
SHERPA_UI_PASSWORD=change-me
SHERPA_DBT_TARGET_PATH=data-platform/dbt/target-prod
# The MCP server's transport (stdio or http) and its HTTP port (bound to 127.0.0.1).
MCP_TRANSPORT=stdio
SHERPA_MCP_PORT=8765
# How many warehouse connections the MCP server may hold at once.
SHERPA_MCP_POOL_SIZE=4
# The web app's port (bound to 127.0.0.1).
SHERPA_UI_PORT=8090
# The web app's per-query timeout (whole seconds) and row cap.
SHERPA_UI_STATEMENT_TIMEOUT_S=30
SHERPA_UI_ROW_CAP=1000
# Optional traces: with an endpoint the host-side processes (agent, `make mcp-dev`) export spans to Jaeger
# (`docker compose --profile jaeger up -d jaeger`, UI at http://127.0.0.1:16686); without one nothing is exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# The same collector as the compose `mcp` service reaches it.
# SHERPA_CONTAINER_OTLP_ENDPOINT=http://jaeger:4318
# Where a trace id opens in the UI ({trace_id} is replaced).
# SHERPA_TRACE_URL_TEMPLATE=http://127.0.0.1:16686/trace/{trace_id}
# Behind a TLS-intercepting proxy, point uv and dbt at a CA bundle that includes the proxy's root certificate:
# SSL_CERT_FILE=/path/to/ca-bundle.pem
# REQUESTS_CA_BUNDLE=/path/to/ca-bundle.pem
